# Copy to .env.local (development) or set in your hosting provider.
# Never commit real values.

# --- Site -------------------------------------------------------------
# Canonical origin, used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Call / WhatsApp number (E.164). Defaults to +919032458800 when empty.
NEXT_PUBLIC_SALES_PHONE=

# --- Analytics (use ONE of these) --------------------------------------
# Google Tag Manager container, e.g. GTM-XXXXXXX (preferred).
NEXT_PUBLIC_GTM_ID=
# GA4 measurement ID, e.g. G-XXXXXXXXXX — only used when no GTM ID is set.
NEXT_PUBLIC_GA4_ID=

# --- Lead delivery (server only) ----------------------------------------
# HTTPS endpoint that receives each enquiry as JSON (CRM webhook / middleware).
CRM_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>".
CRM_WEBHOOK_SECRET=
# Development only: "log" prints enquiries to the server console instead of
# delivering them. Ignored in production — without CRM_WEBHOOK_URL the form
# reports an error rather than pretending to succeed.
LEAD_DELIVERY_MODE=
